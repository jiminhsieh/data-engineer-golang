# Copy to .env and replace placeholders. Never commit .env.
OPENWEATHER_API_KEY=replace-with-a-non-production-key
WEATHER_LAT=44.34
WEATHER_LON=10.99
DATABASE_URL=postgresql://weather:replace-with-a-local-password@postgres:5432/weather?sslmode=disable
POSTGRES_USER=weather
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=weather
ETL_INTERVAL=30s
HTTP_TIMEOUT=10s
HTTP_ADDR=:8080
DATA_DIR=/app/data
LOG_FILE=/app/logs/etl.log
LOG_STDOUT=true
SHUTDOWN_GRACE=10s
# OPENWEATHER_BASE_URL defaults to the official HTTPS current-weather endpoint.
